@model IEnumerable<DepartmentToReturnDTO>
@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Departments</h2>
        <a asp-controller="Department" asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus me-1"></i> Create New
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive rounded shadow-sm">
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(d => d.Code)</th>
                        <th>@Html.DisplayNameFor(d => d.Name)</th>
                        <th>@Html.DisplayNameFor(d => d.CreationDate)</th>
                        <th colspan="3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var department in Model)
                    {
                        var modalId = $"deleteModal_{department.Id}";
                        <tr>
                            <td>@department.Code</td>
                            <td>@department.Name</td>
                            <td>@department.CreationDate.ToShortDateString()</td>

                            <partial name="_ButtonsPartial" model="@department.Id" />

                            <td>
                                <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </td>

                            <!-- Modal -->
                            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="modalLabel_@department.Id" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title" id="modalLabel_@department.Id">
                                                Delete Confirmation
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete the department
                                            <strong class="text-danger">"@department.Name"</strong>?
                                        </div>
                                        <div class="modal-footer">
                                            <form asp-action="Delete" asp-route-id="@department.Id" method="post">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center p-4 shadow-sm">
            <h4 class="mb-0">No departments found 😔</h4>
        </div>
    }
</div>
