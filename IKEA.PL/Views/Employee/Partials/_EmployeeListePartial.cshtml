@model IEnumerable<EmployeeDto>

@foreach (var employee in Model)
{
    var modalId = $"deleteModal_{employee.Id}";
    <tr class="align-middle">
        <td>@employee.Name</td>
        <td>@employee.Email</td>
        <td>@employee.Department</td>
        <td>@employee.EmployeeType</td>
        <td>@employee.Age</td>
        <td>@employee.Salary</td>
        <td>
            @if (employee.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger">Inactive</span>
            }
        </td>
        <td>
            <span class="badge bg-secondary">@employee.Gender</span>
        </td>
        <partial name="_ButtonsPartial" model="@employee.Id" />
        <td>
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </td>
    </tr>

    <!-- Modal - place OUTSIDE of table for valid HTML -->
    <tr>
        <td colspan="11">
            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="modalLabel_@employee.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="modalLabel_@employee.Id">
                                <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-start">
                            Are you sure you want to delete employee:
                            <strong class="text-danger">@employee.Name</strong>?
                        </div>
                        <div class="modal-footer">
                            <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </td>
    </tr>
}
