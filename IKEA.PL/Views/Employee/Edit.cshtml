@using IKEA.BLL.Services
@using IKEA.DAL.Common.Enum
@model UpdatedEmployeeDto
@{
    ViewData["Title"] = "Edit";
}


    <form asp-action="Edit" class="row col-12">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group col-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control mb-2" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control mb-2" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control mb-2" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="Age" class="form-label"></label>
            <input asp-for="Age" class="form-control mb-2" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="Salary" class="form-label"></label>
            <input asp-for="Salary" class="form-control mb-2" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control mb-2" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="EmployeeType" class="form-label"></label>
            <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control mb-2">
                <option value="">-- Choose Type --</option>
            </select>
            <span asp-validation-for="EmployeeType" class="text-danger"></span>
        </div>

        <div class="form-group col-6">
            <label asp-for="Gender" class="form-label d-block">Gender</label>
            @foreach (Gender genderOption in Enum.GetValues(typeof(Gender)))
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Gender" value="@genderOption" />
                    <label class="form-check-label">@genderOption</label>
                </div>
            }
            <span asp-validation-for="Gender" class="text-danger d-block mt-1"></span>
        </div>

        <div class="form-group col-12 mt-3">
            <label asp-for="HiringDate" class="form-label"></label>
            <input asp-for="HiringDate" type="date" class="form-control mb-2" />
            <span asp-validation-for="HiringDate" class="text-danger"></span>
        </div>

        <div class="form-group col-12 my-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive">Is Active</label>
            </div>
        </div>

        <div class="form-group mt-3">
            <input type="submit" value="Save" class="btn btn-success" />
            <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary ms-2">Back To List</a>
        </div>
    </form>
</div>
@section ValidationScript {
   <partial name="_ValidationScriptsPartial" />
}

