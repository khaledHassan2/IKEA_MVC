@model IEnumerable<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Employees</h2>
        <a asp-controller="Employee" asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus me-1"></i> Create New
        </a>
    </div>

    <form asp-action="Index" method="get" class="row g-3 mb-4 align-items-center justify-content-center">
        <div class="col-md-6">
            <input type="text" name="search" class="form-control" id="searchInp" placeholder="🔍 Search by name..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-search me-1"></i> Search
            </button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-responsive rounded shadow-sm">
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(x => x.Name)</th>
                        <th>@Html.DisplayNameFor(x => x.Email)</th>
                        <th>@Html.DisplayNameFor(x => x.Department)</th>
                        <th>@Html.DisplayNameFor(x => x.EmployeeType)</th>
                        <th>@Html.DisplayNameFor(x => x.Age)</th>
                        <th>@Html.DisplayNameFor(x => x.Salary)</th>
                        <th>@Html.DisplayNameFor(x => x.IsActive)</th>
                        <th>@Html.DisplayNameFor(x => x.Gender)</th>
                        <th colspan="3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <partial name="Partials/_EmployeeListePartial" />
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center p-4 shadow-sm">
            <h4 class="mb-0">No employees found 🙁</h4>
        </div>
    }
</div>
